SPOTTER_ORIGIN=https://spotter.blupe.io
YAM_SESSION_API=https://yam-session-api.n5hthc3gj4cqy.us-east-1.cs.amazonlightsail.com
SPOTTER_POLICY_ENDPOINT=https://YOUR_DREAMZERO_ENDPOINT.api.runpod.ai
SPOTTER_POLICY_KEY_FILE=/etc/blupe-spotter/dreamzero-key
SPOTTER_VLM_ENDPOINT=http://127.0.0.1:8301/v1
SPOTTER_VLM_MODEL=qwen38
# Optional for an authenticated model server:
# SPOTTER_VLM_KEY_FILE=/etc/blupe-spotter/qwen-key
SPOTTER_MAX_LEAD=2
# Durable recordings are supported only for a localhost development origin.
# Public hosting uses private, ephemeral visitor recordings.
# SPOTTER_RECORDINGS=/var/lib/blupe-spotter/recordings
